# Supabase 대시보드 > Project Settings > API (또는 API Keys)
SUPABASE_URL=https://enmmpsobochypfmbzysy.supabase.co
# anon 키 또는 publishable 키 (sb_publishable_...)
SUPABASE_ANON_KEY=
# service_role 키 또는 secret 키 (sb_secret_...)  ※ 절대 프론트/깃에 올리지 말 것
SUPABASE_SERVICE_KEY=

# ESP32가 백엔드에 보낼 비밀 키 (아무 긴 랜덤 문자열)
DEVICE_API_KEY=
DEVICE_ID=xiao-01

# 프론트 배포 후 Vercel 주소로 좁히기. 쉼표로 여러 개 가능
CORS_ORIGINS=*
